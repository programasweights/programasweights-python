set(CMAKE_INSTALL_RPATH "$ORIGIN" CACHE STRING "")
set(CMAKE_C_FLAGS "-march=x86-64 -mtune=generic" CACHE STRING "")
set(CMAKE_CXX_FLAGS "-march=x86-64 -mtune=generic" CACHE STRING "")
foreach(feature IN ITEMS GGML_BACKEND_DL GGML_CPU_ALL_VARIANTS GGML_LLAMAFILE GGML_OPENMP GGML_CPU_REPACK)
    set(${feature} ON CACHE BOOL "" FORCE)
endforeach()
foreach(feature IN ITEMS GGML_NATIVE GGML_BLAS GGML_CUDA LLAMA_OPENSSL GGML_CCACHE GGML_LTO)
    set(${feature} OFF CACHE BOOL "" FORCE)
endforeach()
